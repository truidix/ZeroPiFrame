# Photoframe Configuration
# Copy to /opt/photoframe/config.yaml and adjust.

# Language of the web interface. Available values depend on which files
# are present under src/translations/ (e.g. "de", "en") - can also be set
# in the web interface itself via the language selector at the top right,
# which then writes it here automatically.
language: de

# Active image source: "nextcloud" or "immich"
source: nextcloud

# ---------------------------------------------------------------------------
# Nextcloud / WebDAV
# ---------------------------------------------------------------------------
nextcloud:
  # WebDAV URL: in Nextcloud under Settings -> Files -> WebDAV address
  url: "https://cloud.example.com/remote.php/dav/files/BENUTZERNAME/Fotos/"
  username: "mein_benutzer"
  password: "mein_passwort"
  # Optional: only sync specific subfolders (empty = everything)
  # folders:
  #   - "Vacation 2024"
  #   - "Family"
  verify_ssl: true   # false for a self-signed certificate
  # Optional: photos whose shorter side is below this value (pixels) are
  # discarded after download (WebDAV doesn't provide the resolution in
  # advance, unlike Immich). Guards against visible pixelation from
  # upscaling originals that are already low resolution to begin with.
  # 0 = no filter. Photos already in the cache that fall below the
  # threshold are automatically removed from the cache on the next sync
  # (delete_removed).
  min_resolution_px: 0

# ---------------------------------------------------------------------------
# Immich
# ---------------------------------------------------------------------------
immich:
  url: "http://192.168.1.100:2283"
  api_key: "DEIN_API_KEY_HIER"
  # Optional: only specific albums (empty or omitted = all photos)
  # albums:
  #   - "Picture Frame"
  all_photos: true   # automatically becomes false if albums is set
  # Optional: photos whose shorter side is below this value (pixels) are
  # not even downloaded. Useful against visible pixelation from upscaling
  # originals that are already low resolution to begin with (old phone
  # photos, WhatsApp compression, screenshots). 0 = no filter. Photos
  # already in the cache that fall below the threshold are automatically
  # removed from the cache on the next sync (delete_removed).
  min_resolution_px: 0

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------
sync:
  interval_minutes: 60        # How often to synchronize
  max_cache_size_gb: 5.0      # Maximum cache size (oldest images are removed)
  delete_removed: true        # Delete locally when no longer present on the server

# ---------------------------------------------------------------------------
# Slideshow
# ---------------------------------------------------------------------------
slideshow:
  interval_seconds: 30        # Display duration per image
  # Enabled transitions (multi-select in the web UI). With more than one
  # entry, the slideshow randomly alternates between them on each image.
  # Possible values: none, fade, ken_burns, slide_left, slide_right,
  #                 slide_up, slide_down, wipe_left, wipe_right, wipe_up,
  #                 wipe_down, zoom_in, dissolve, iris, barn_door, blinds, flash
  enabled_transitions:
    - "ken_burns"
  transition_duration_ms: 1500
  ken_burns_zoom: 0.08        # Zoom strength (0.04-0.20)
  shuffle: true               # Random order
  fit_mode: "contain"         # "contain" (letterbox bars) or "cover" (crop)
  background_color: "#000000"
  video_enabled: true         # Play videos (MP4, MKV, MOV, AVI ...)
  video_audio: false          # Sound for videos (true = with sound)

# ---------------------------------------------------------------------------
# Display / power saving
# ---------------------------------------------------------------------------
display:
  # HDMI schedule (empty = always on)
  on_time:  "08:00"
  off_time: "23:00"
  # Automatic shutdown (empty = disabled). For operation on a timer
  # switch/smart plug: the Pi shuts itself down cleanly a few minutes
  # BEFORE the plug's scheduled power-off time, instead of having the
  # power cut raw (which is easier on the SD card). The Pi boots back up
  # automatically the next time the plug switches on.
  shutdown_time: "22:55"
