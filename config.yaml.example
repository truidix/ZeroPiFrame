# Photoframe Konfiguration
# Kopieren nach /opt/photoframe/config.yaml und anpassen.

# Aktive Bildquelle: "nextcloud" oder "immich"
source: nextcloud

# ---------------------------------------------------------------------------
# Nextcloud / WebDAV
# ---------------------------------------------------------------------------
nextcloud:
  # WebDAV-URL: In Nextcloud unter Einstellungen → Dateien → WebDAV-Adresse
  url: "https://cloud.example.com/remote.php/dav/files/BENUTZERNAME/Fotos/"
  username: "mein_benutzer"
  password: "mein_passwort"
  # Optional: Nur bestimmte Unterordner synchronisieren (leer = alles)
  # folders:
  #   - "Urlaub 2024"
  #   - "Familie"
  verify_ssl: true   # false bei selbstsigniertem Zertifikat
  # Optional: Fotos mit kleinerer Seite unter diesem Wert (Pixel) werden nach
  # dem Download verworfen (WebDAV liefert die Auflösung nicht im Voraus,
  # anders als bei Immich). Gegen sichtbares Pixelbrei durch Hochskalieren
  # von von Haus aus niedrig aufgelösten Originalen. 0 = kein Filter.
  # Bereits gecachte Fotos unterhalb des Schwellwerts werden beim nächsten
  # Sync automatisch aus dem Cache entfernt (delete_removed).
  min_resolution_px: 0

# ---------------------------------------------------------------------------
# Immich
# ---------------------------------------------------------------------------
immich:
  url: "http://192.168.1.100:2283"
  api_key: "DEIN_API_KEY_HIER"
  # Optional: Nur bestimmte Alben (leer oder weglassen = alle Fotos)
  # albums:
  #   - "Bilderrahmen"
  all_photos: true   # wird automatisch false wenn albums angegeben
  # Optional: Fotos mit kleinerer Seite unter diesem Wert (Pixel) werden gar
  # nicht erst heruntergeladen. Nützlich gegen sichtbares Pixelbrei durch
  # Hochskalieren von von Haus aus niedrig aufgelösten Originalen (alte
  # Handyfotos, WhatsApp-Komprimierung, Screenshots). 0 = kein Filter.
  # Bereits gecachte Fotos unterhalb des Schwellwerts werden beim nächsten
  # Sync automatisch aus dem Cache entfernt (delete_removed).
  min_resolution_px: 0

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------
sync:
  interval_minutes: 60        # Wie oft synchronisiert wird
  max_cache_size_gb: 5.0      # Maximale Cache-Größe (älteste Bilder werden entfernt)
  delete_removed: true        # Lokal löschen wenn auf Server nicht mehr vorhanden

# ---------------------------------------------------------------------------
# Slideshow
# ---------------------------------------------------------------------------
slideshow:
  interval_seconds: 30        # Anzeigedauer pro Bild
  # Aktivierte Übergänge (Mehrfachauswahl im Web-UI). Bei mehr als einem
  # Eintrag wechselt die Slideshow bei jedem Bild zufällig zwischen ihnen.
  # Mögliche Werte: none, fade, ken_burns, slide_left, slide_right,
  #                 slide_up, slide_down, wipe_left, wipe_right, wipe_up,
  #                 wipe_down, zoom_in, dissolve, iris, barn_door, blinds, flash
  enabled_transitions:
    - "ken_burns"
  transition_duration_ms: 1500
  ken_burns_zoom: 0.08        # Zoom-Stärke (0.04–0.20)
  shuffle: true               # Zufällige Reihenfolge
  fit_mode: "contain"         # "contain" (Balken) oder "cover" (zuschneiden)
  background_color: "#000000"
  video_enabled: true         # Videos abspielen (MP4, MKV, MOV, AVI …)
  video_audio: false          # Ton bei Videos (true = mit Ton)

# ---------------------------------------------------------------------------
# Display / Energiesparen
# ---------------------------------------------------------------------------
display:
  # HDMI-Zeitplan (leer = immer an)
  on_time:  "08:00"
  off_time: "23:00"
  # Automatisches Herunterfahren (leer = deaktiviert). Für Betrieb an einer
  # Zeitschaltuhr/Smart-Plug: der Pi fährt sich selbst ein paar Minuten VOR
  # der geplanten Abschaltzeit der Steckdose sauber herunter, statt dass der
  # Strom roh gekappt wird (schont die SD-Karte). Beim nächsten Einschalten
  # der Steckdose bootet der Pi automatisch neu.
  shutdown_time: "22:55"
